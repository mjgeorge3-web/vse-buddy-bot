{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "data/**,knowledge/**,results/**,*.py,*.json"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__route=$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
